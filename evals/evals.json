      { "functionName": "clear_filters", "arguments": {} },
      { "functionName": "get_flight_results", "arguments": {} }
    ]
  },
  {
    "name": "Inspection only, no selection",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "I'm just browsing. Search San Francisco to New York on December 12, 2026 and list the flights from earliest to latest departure. Don't select anything."
