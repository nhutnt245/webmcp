          { "functionName": "sort_flights", "arguments": { "by": "duration", "order": "asc" } }
        ]
      },
      {
        "ordered": [
          { "functionName": "get_flight_results", "arguments": {} },
          { "functionName": "select_flight", "arguments": { "flight_id": "DM404" } }
        ]
      }
    ]
  },
  {
    "name": "No match, then recover without selecting",
    "messages": [
