# Set in your shell; Node does not automatically load this file.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional for all drivers:
DEMO_URL=http://127.0.0.1:3000
# Optional for computer use:
MAX_TURNS=20
# Optional for scripted drivers: show the browser
HEADED=0
# Optional existing browser binary (otherwise install Playwright Chromium):
# CHROMIUM_EXECUTABLE_PATH=/absolute/path/to/chrome
